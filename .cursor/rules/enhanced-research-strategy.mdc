```

### **MCP Configuration Updates**

```jsonc
// Enhanced MCP configuration
{
  "mcpServers": {
    "exa": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.exa.ai/mcp?exaApiKey=${EXA_API_KEY}"],
      "env": {}
    },
    "zen": {
      "command": "uvx",
      "args": ["--from", "git+https://github.com/BeehiveInnovations/zen-mcp-server.git", "zen-mcp-server"],
      "env": {
        "XAI_API_KEY": "${XAI_API_KEY}",
        "GOOGLE_ALLOWED_MODELS": "gemini-2.5-pro",
        "GEMINI_API_KEY": "${GEMINI_API_KEY}",
        "OPENAI_ALLOWED_MODELS": "gpt-5"
      }
    },
    "sequentialthinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "env": {}
    }
  }
}
```

