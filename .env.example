# MCP Environment Configuration Template
# Copy this file to .env and replace with your actual API keys
# DO NOT commit .env file to version control

# Context7 API - Library documentation
CONTEXT7_API_KEY=your_context7_api_key_here

# OpenAI API - GPT models
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API - Gemini models  
GEMINI_API_KEY=your_gemini_api_key_here

# X.AI API - GROK models
XAI_API_KEY=your_xai_api_key_here

# Milvus Vector Database - Claude Context
MILVUS_ADDRESS=your_milvus_address_here
MILVUS_TOKEN=your_milvus_token_here

# Brave Search API - Web search
BRAVE_API_KEY=your_brave_api_key_here

# OpenMemory API - Persistent memory
OPENMEMORY_API_KEY=your_openmemory_api_key_here

# Tavily API - Real-time search
TAVILY_API_KEY=your_tavily_api_key_here

# Exa API - Semantic search
EXA_API_KEY=your_exa_api_key_here